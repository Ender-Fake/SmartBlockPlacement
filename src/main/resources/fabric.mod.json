{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A client mod that adds a quick block placement feature, but does it smartly.",
  "authors": ["Ender_Fake"],
  "contact": {
    "repo": "https://github.com/Ender-Fake/SmartBlockPlacement",
    "issues": "https://github.com/Ender-Fake/SmartBlockPlacement/issues"
  },
  "license": "MIT",
  "icon": "assets/smartblockplacement/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.enderium.smartblockplacement.client.SmartBlockPlacementClientFabric"
    ],
    "modmenu": ["com.enderium.smartblockplacement.config.ModMenuEntrypoint"]
  },
  "mixins": [
    "smartblockplacement.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
